#: templates/django_cotton_gallery/docs.html:224
msgid "Anatomy"
msgstr "Anatomia"

#: templates/django_cotton_gallery/docs.html:21
#: templates/django_cotton_gallery/docs.html:236
msgid "Prop types"
msgstr "Prop motak"

#: templates/django_cotton_gallery/docs.html:22
#: templates/django_cotton_gallery/docs.html:252
msgid "Filters"
msgstr "Iragazkiak"

#: templates/django_cotton_gallery/docs.html:23
msgid "Dynamic props"
msgstr "Prop dinamikoak"

#: templates/django_cotton_gallery/docs.html:24
#: templates/django_cotton_gallery/docs.html:280
msgid "Slots &amp; triggers"
msgstr "Slotak eta triggerrak"

#: templates/django_cotton_gallery/docs.html:25
#: templates/django_cotton_gallery/docs.html:356
msgid "Rules &amp; gotchas"
msgstr "Arauak eta abisuak"

#: templates/django_cotton_gallery/docs.html:26
#: templates/django_cotton_gallery/docs.html:304
msgid "Playground features"
msgstr "Jolastokiaren ezaugarriak"

#: templates/django_cotton_gallery/docs.html:32
msgid ""
"Every setting below is read from your project's <code>settings.py</code>. "
"None of them are required — the gallery boots with sensible defaults. "
"Override only what you need."
msgstr ""
"Beheko ezarpen bakoitza zure proiektuko <code>settings.py</code>-tik "
"irakurtzen da. Bat ere ez da derrigorrezkoa — galeriak ezarpen lehenetsi "
"zentzudunekin abiarazten da. Behar duzuna bakarrik gainidatzi."

#: templates/django_cotton_gallery/docs.html:34
msgid "Cotton &amp; component paths"
msgstr "Cotton eta osagai-bideak"

#: templates/django_cotton_gallery/docs.html:37
#: templates/django_cotton_gallery/docs.html:59
#: templates/django_cotton_gallery/docs.html:99
msgid "Setting"
msgstr "Ezarpena"

#: templates/django_cotton_gallery/docs.html:44
msgid ""
"Cotton's own setting. The gallery indexes both styles transparently — the "
"Insights page surfaces a warning if you have hyphens in filenames AND "
"<code>True</code> (the one combo cotton can't resolve, since it would look "
"up <code>foo_bar.html</code> for <code>&lt;c-foo-bar /&gt;</code>)."
msgstr ""
"Cotton-en beraren ezarpena. Galeriak bi estiloak modu garden batean "
"indexatzen ditu — Insights orriak abisu bat erakusten du fitxategi-izenetan "
"marrak ETA <code>True</code> baduzu (cotton-ek ezin du konbinazio hori "
"ebatzi, <code>foo_bar.html</code> bilatuko bailuke <code>&lt;c-foo-bar /&gt;"
"</code>-rako)."

#: templates/django_cotton_gallery/docs.html:50
msgid ""
"Cotton's own setting. Subfolder under each <code>templates/</code> root that "
"holds the components — the gallery just reads it."
msgstr ""
"Cotton-en beraren ezarpena. <code>templates/</code> erro bakoitzaren azpiko "
"azpikarpeta non osagaiak dauden — galeriak besterik gabe irakurtzen du."

#: templates/django_cotton_gallery/docs.html:55
msgid "Catalog ordering &amp; filtering"
msgstr "Katalogoaren ordenazioa eta iragazketa"

#: templates/django_cotton_gallery/docs.html:56
msgid ""
"Top-level folders inside <code>COTTON_DIR</code> become <em>categories</em> "
"(atoms, molecules, etc.). One level deeper become <em>subcategories</em> "
"(atoms/ui, atoms/form, etc.)."
msgstr ""
"<code>COTTON_DIR</code> barruko goiko mailako karpetak <em>kategoria</em> "
"bihurtzen dira (atoms, molecules, etab.). Maila bat sakonago "
"<em>azpikategoria</em> bihurtzen dira (atoms/ui, atoms/form, etab.)."

#: templates/django_cotton_gallery/docs.html:66
msgid ""
"Top-level folders to hide from the index entirely. Folders whose name starts "
"with <code>_</code> are excluded automatically."
msgstr ""
"Indizetik erabat ezkutatzeko goiko mailako karpetak. <code>_</code>-rekin "
"hasten diren karpeten izenak automatikoki baztertzen dira."

#: templates/django_cotton_gallery/docs.html:72
msgid ""
"Categories pinned to the top of the sidebar in this exact order. Anything "
"not listed sorts by <code>DJANGO_COTTON_GALLERY_CATEGORY_SORT</code>."
msgstr ""
"Alboko barraren goian iltzatutako kategoriak ordena zehatz honetan. "
"Zerrendatzen ez dena <code>DJANGO_COTTON_GALLERY_CATEGORY_SORT</code> bidez "
"ordenatzen da."

#: templates/django_cotton_gallery/docs.html:78
msgid ""
"Sort direction for categories not listed in "
"<code>DJANGO_COTTON_GALLERY_CATEGORY_ORDER</code>."
msgstr ""
"<code>DJANGO_COTTON_GALLERY_CATEGORY_ORDER</code>-en zerrendatzen ez diren "
"kategorien ordenazio-norabidea."

#: templates/django_cotton_gallery/docs.html:84
msgid ""
"Per-category mapping of subcategory names pinned to the top. Example: "
"<code>{'atoms': ['ui', 'form']}</code>."
msgstr ""
"Goian finkatutako azpikategoria-izenen kategoriako mapaketa. Adibidea: "
"<code>{'atoms': ['ui', 'form']}</code>."

#: templates/django_cotton_gallery/docs.html:90
msgid ""
"Sort direction for subcategories not listed in "
"<code>DJANGO_COTTON_GALLERY_SUBCATEGORY_ORDER</code>."
msgstr ""
"<code>DJANGO_COTTON_GALLERY_SUBCATEGORY_ORDER</code>-en zerrendatzen ez "
"diren azpikategorien ordenazio-norabidea."

#: templates/django_cotton_gallery/docs.html:95
msgid "Asset injection — external URLs"
msgstr "Aktiboen injekzioa — kanpoko URLak"

#: templates/django_cotton_gallery/docs.html:96
msgid ""
"For external stylesheets and scripts (Leaflet, HTMX, Alpine, your compiled "
"bundle), pass URLs as lists. The gallery auto-detects known libraries from "
"these URLs to render the dependency badges in the hero."
msgstr ""
"Kanpoko estilo-orri eta script-entzat (Leaflet, HTMX, Alpine, zure "
"konpilatutako paketea), pasatu URLak zerrenda gisa. Galeriak liburutegi "
"ezagunak automatikoki detektatzen ditu URL hauetatik mendekotasun-"
"bereizgarriak hero atalean errendatzeko."

#: templates/django_cotton_gallery/docs.html:106
msgid "URLs (static or absolute) loaded in the <code>&lt;head&gt;</code>."
msgstr ""
"<code>&lt;head&gt;</code>-en kargatzen diren URLak (estatikoak edo "
"absolutuak)."

#: templates/django_cotton_gallery/docs.html:112
msgid "URLs loaded before <code>&lt;/body&gt;</code>."
msgstr "<code>&lt;/body&gt;</code> aurretik kargatzen diren URLak."

#: templates/django_cotton_gallery/docs.html:117
msgid "Asset injection — inline HTML via partials"
msgstr "Aktiboen injekzioa — HTML inlinea partzialen bidez"

#: templates/django_cotton_gallery/docs.html:118
msgid ""
"For <strong>inline</strong> HTML/JS (Tailwind play-CDN config, preconnect "
"hints, HTMX/Alpine bridges, env keys), drop a template partial in your "
"project's templates directory. The gallery picks it up automatically — no "
"settings change."
msgstr ""
"<strong>Inline</strong> HTML/JS-rentzat (Tailwind play-CDN konfig., "
"preconnect-ak, HTMX/Alpine zubiak, ingurune-gakoak), bota txantiloi "
"partziala zure proiektuaren txantiloi-direktorioan. Galeriak automatikoki "
"hartzen du — ezarpen-aldaketarik gabe."

#: templates/django_cotton_gallery/docs.html:121
msgid "Path"
msgstr "Bidea"

#: templates/django_cotton_gallery/docs.html:121
msgid "Where it renders"
msgstr "Non errendatzen den"

#: templates/django_cotton_gallery/docs.html:121
msgid "Use it for"
msgstr "Erabili honetarako"

#: templates/django_cotton_gallery/docs.html:126
msgid "End of <code>&lt;head&gt;</code>"
msgstr "<code>&lt;head&gt;</code>-aren amaiera"

#: templates/django_cotton_gallery/docs.html:127
msgid ""
"Preconnects, Tailwind config, design-token CSS variables, env-driven "
"<code>window.*</code> globals (API keys, feature flags)."
msgstr ""
"Preconnect-ak, Tailwind konfig., diseinu-tokenen CSS aldagaiak, ingurunearen "
"araberako <code>window.*</code> globalak (API gakoak, ezaugarri-banderak)."

#: templates/django_cotton_gallery/docs.html:131
msgid "Just before <code>&lt;/body&gt;</code>"
msgstr "<code>&lt;/body&gt;</code> baino lehen"

#: templates/django_cotton_gallery/docs.html:132
msgid ""
"HTMX/Alpine bridges, post-mount config, anything that has to run after the "
"components mount."
msgstr ""
"HTMX/Alpine zubiak, mount ondoko konfig., osagaiak muntatu ondoren exekutatu "
"behar den edozein gauza."

#: templates/django_cotton_gallery/docs.html:136
msgid ""
"<strong>Recommended:</strong> use the partials approach for inline HTML — it "
"keeps your <code>settings.py</code> minimal and lets your editor syntax-"
"highlight the markup. The settings-based <code>EXTRA_CSS</code>/"
"<code>EXTRA_JS</code> approach still works and is the way to go when you "
"want each URL to surface as a dependency badge in the hero."
msgstr ""
"<strong>Gomendatua:</strong> erabili partial-en bidea HTML inline-rako — "
"zure <code>settings.py</code> minimo mantentzen du eta zure editoreari kodea "
"koloreztatzen uzten dio. Settings bidezko <code>EXTRA_CSS</code>/"
"<code>EXTRA_JS</code> hurbilketak funtzionatzen jarraitzen du eta bide hori "
"da URL bakoitza hero-an mendekotasun-badge gisa agertzea nahi duzunean."

#: templates/django_cotton_gallery/docs.html:137
#, python-format
msgid ""
"Both partials are <strong>optional</strong>. Drop the file in to add the "
"inject, delete it to remove it. The gallery uses a custom <code>&#123;%% "
"maybe_include %%&#125;</code> templatetag so missing files are silently "
"skipped."
msgstr ""
"Bi partial-ak <strong>aukerakoak</strong> dira. Jarri fitxategia injekzioa "
"gehitzeko, ezabatu kentzeko. Galeriak <code>&#123;%% maybe_include %%&#125;</"
"code> templatetag pertsonalizatua erabiltzen du, beraz, falta diren "
"fitxategiak isilean saltatzen dira."

#: templates/django_cotton_gallery/docs.html:139
msgid "Example: <code>_extra_head.html</code>"
msgstr "Adibidea: <code>_extra_head.html</code>"

#: templates/django_cotton_gallery/docs.html:140
msgid ""
"A typical head partial for a project that runs Tailwind via the play-CDN and "
"exposes an API key to the components:"
msgstr ""
"Tailwind play-CDN bidez exekutatzen duen eta osagaiei API gakoa erakusten "
"dien proiektu baten ohiko head partziala:"

#: templates/django_cotton_gallery/docs.html:160
#: templates/django_cotton_gallery/docs.html:182
#: templates/django_cotton_gallery/docs.html:204
#: templates/django_cotton_gallery/docs.html:213
#: templates/django_cotton_gallery/docs.html:231
#: templates/django_cotton_gallery/docs.html:275
#: templates/django_cotton_gallery/docs.html:285
#: templates/django_cotton_gallery/docs.html:292
#: templates/django_cotton_gallery/docs.html:299
#: templates/django_cotton_gallery/docs.html:326
#: templates/django_cotton_gallery/get-started.html:39
#: templates/django_cotton_gallery/get-started.html:51
#: templates/django_cotton_gallery/get-started.html:66
#: templates/django_cotton_gallery/get-started.html:80
#: templates/django_cotton_gallery/get-started.html:99
#: templates/django_cotton_gallery/get-started.html:111
msgid "Copy code"
msgstr "Kopiatu kodea"

#: templates/django_cotton_gallery/docs.html:163
msgid "Example: a working <code>settings.py</code>"
msgstr "Adibidea: <code>settings.py</code> funtzionatzen duena"

#: templates/django_cotton_gallery/docs.html:164
msgid ""
"Only the gallery's own settings are shown — cotton's settings "
"(<code>COTTON_SNAKE_CASED_NAMES</code>, <code>COTTON_DIR</code>) belong to "
"django-cotton, not to this gallery, and are documented in cotton's docs."
msgstr ""
"Galeriaren beraren ezarpenak soilik agertzen dira — cotton-en ezarpenak "
"(<code>COTTON_SNAKE_CASED_NAMES</code>, <code>COTTON_DIR</code>) django-"
"cotton-arenak dira, ez galeria honenak, eta cotton-en dokumentazioan "
"agertzen dira."

#: templates/django_cotton_gallery/docs.html:185
msgid "Language switcher"
msgstr "Hizkuntza-aldatzailea"

#: templates/django_cotton_gallery/docs.html:186
#: templates/django_cotton_gallery/get-started.html:89
msgid ""
"The gallery ships with translations for English, Spanish, Basque, and "
"French. The dropdown in the sidebar footer only appears when your project "
"has Django's i18n URL and middleware wired — without them, Django can't "
"persist the chosen language, so the gallery hides the control to avoid a "
"dead button."
msgstr ""
"Galeriak ingelesa, gaztelania, euskara eta frantsesa itzulpenak dakartza. "
"Alboko barraren oinetako goitibeherakoa zure proiektuak Django-ren i18n URLa "
"eta middleware-a konfiguratuta dituenean soilik agertzen da — horiek gabe, "
"Django-k ezin du aukeratutako hizkuntza iraunkorrarazi, beraz, galeriak "
"kontrola ezkutatzen du botoi hil bat saihesteko."

#: templates/django_cotton_gallery/docs.html:206
msgid ""
"Order matters: <code>LocaleMiddleware</code> must come <strong>after</"
"strong> <code>SessionMiddleware</code> and <strong>before</strong> "
"<code>CommonMiddleware</code>. To expose more or fewer locales, set "
"<code>LANGUAGES</code> in your <code>settings.py</code> — the gallery picks "
"up whatever is configured."
msgstr ""
"Ordena garrantzitsua da: <code>LocaleMiddleware</code> "
"<code>SessionMiddleware</code>-ren <strong>ondoren</strong> eta "
"<code>CommonMiddleware</code>-ren <strong>aurretik</strong> joan behar da. "
"Locale gehiago edo gutxiago erakusteko, ezarri <code>LANGUAGES</code> zure "
"<code>settings.py</code>-n — galeriak konfiguratuta dagoena hartzen du."

#: templates/django_cotton_gallery/docs.html:208
msgid "Lint in CI"
msgstr "Lint CI-an"

#: templates/django_cotton_gallery/docs.html:209
msgid ""
"The same lint engine that powers the in-app Lint report ships as a Django "
"management command. Wire it into CI to fail builds on annotation regressions:"
msgstr ""
"App-aren barruko Lint txostena bultzatzen duen lint motor bera Django "
"management command gisa banatzen da. Konektatu zure CI-ra build-ak hutsik "
"utz ditzan anotazio-erregresioen aurrean:"

#: templates/django_cotton_gallery/docs.html:215
msgid ""
"Same rules and severities as the web report. The CLI's exit-code logic "
"considers <strong>errors</strong> and (with the flag) <strong>warnings</"
"strong>; hints are surfaced in the web report but don't affect CI exit codes."
msgstr ""
"Web txostenaren arau eta larritasun berberak. CLI-aren irteera-kodearen "
"logikak <strong>erroreak</strong> eta (flag-arekin) <strong>abisuak</strong> "
"kontuan hartzen ditu; pistak (hints) web txostenean agertzen dira baina ez "
"dute CI-aren irteera-kodean eraginik."

#: templates/django_cotton_gallery/docs.html:220
msgid ""
"The gallery reads <code>&#123;# @prop ... #&#125;</code> comments at the top "
"of each Cotton template to build the props table and the controls panel. The "
"grammar below covers every annotation feature."
msgstr ""
"Galeriak Cotton txantiloi bakoitzaren goialdean <code>&#123;# @prop ... "
"#&#125;</code> iruzkinak irakurtzen ditu propietate-taula eta kontrolen "
"panela eraikitzeko. Beheko gramatikak ohar-ezaugarri guztiak biltzen ditu."

#: templates/django_cotton_gallery/docs.html:225
msgid ""
"One <code>@prop</code> comment per piece of API, then <code>&lt;c-vars&gt;</"
"code> with defaults, then your markup. The shape is always <code>&#123;# "
"@prop name:type | filter | ... #&#125;</code>."
msgstr ""
"API zati bakoitzeko <code>@prop</code> iruzkin bat, gero <code>&lt;c-vars&gt;"
"</code> lehenetsiekin, gero zure markaketa. Forma beti da <code>&#123;# "
"@prop name:type | filter | ... #&#125;</code>."

#: templates/django_cotton_gallery/docs.html:237
msgid "The type after the colon decides which control the gallery renders."
msgstr ""
"Bi puntuen ondorengo motak galeriak zein kontrol errendatzen duen "
"erabakitzen du."

#: templates/django_cotton_gallery/docs.html:240
msgid "Renders"
msgstr "Errendatzen du"

#: templates/django_cotton_gallery/docs.html:243
msgid "Text input"
msgstr "Testu-sarrera"

#: templates/django_cotton_gallery/docs.html:244
msgid "Number input"
msgstr "Zenbaki-sarrera"

#: templates/django_cotton_gallery/docs.html:245
msgid "Toggle"
msgstr "Aldatzailea"

#: templates/django_cotton_gallery/docs.html:246
msgid "Dropdown"
msgstr "Menua"

#: templates/django_cotton_gallery/docs.html:253
msgid "Pipe-separated modifiers. Order doesn't matter."
msgstr "Tutuz bereizitako moldatzaileak. Ordenak ez du axola."

#: templates/django_cotton_gallery/docs.html:256
msgid "Filter"
msgstr "Iragazkia"

#: templates/django_cotton_gallery/docs.html:256
msgid "What it does"
msgstr "Zer egiten duen"

#: templates/django_cotton_gallery/docs.html:259
msgid "Default value. Strings quoted, numbers and booleans bare."
msgstr ""
"Lehenetsitako balioa. Kateak komatxoetan, zenbakiak eta booleanak biluzik."

#: templates/django_cotton_gallery/docs.html:260
msgid "Shown next to the control."
msgstr "Kontrolaren ondoan erakusten da."

#: templates/django_cotton_gallery/docs.html:261
msgid ""
"Marks the prop as mandatory. Only kicks in when there's no <code>default</"
"code>."
msgstr ""
"Propietatea derrigorrezko gisa markatzen du. Soilik <code>default</code>-ik "
"ez dagoenean aplikatzen da."

#: templates/django_cotton_gallery/docs.html:262
msgid "Strikes the prop through and shows the migration note."
msgstr "Propietatea zeharkatuta marratzen du eta migrazio-oharra erakusten du."

#: templates/django_cotton_gallery/docs.html:263
msgid "Removes the prop from the controls panel."
msgstr "Propietatea kontrolen paneletik kentzen du."

#: templates/django_cotton_gallery/docs.html:264
msgid "Sample value shown next to the control."
msgstr "Kontrolaren ondoan erakusten den lagin-balioa."

#: templates/django_cotton_gallery/docs.html:270
msgid "Dynamic props (the <code>:</code> prefix)"
msgstr "Prop dinamikoak (<code>:</code> aurrizkia)"

#: templates/django_cotton_gallery/docs.html:271
msgid ""
"Cotton evaluates the value as a Python expression when the attribute name "
"starts with <code>:</code>. Use it for numbers, booleans, lists — anything "
"that isn't a plain string."
msgstr ""
"Cotton-ek balioa Python adierazpen gisa ebaluatzen du atributu-izena <code>:"
"</code>-rekin hasten denean. Erabili zenbaki, boolean eta zerrendentzat — "
"kate hutsa ez den edozein gauzatarako."

#: templates/django_cotton_gallery/docs.html:281
msgid ""
"Use <code>@slot</code> to describe the default slot. For components that "
"open something (modal, drawer), use <code>@trigger</code> instead."
msgstr ""
"Erabili <code>@slot</code> slot lehenetsia deskribatzeko. Zerbait irekitzen "
"duten osagaietarako (modal, drawer), erabili <code>@trigger</code> ordez."

#: templates/django_cotton_gallery/docs.html:288
msgid "Strict components (<code>@strict</code>)"
msgstr "Osagai zorrotzak (<code>@strict</code>)"

#: templates/django_cotton_gallery/docs.html:289
msgid ""
"Add <code>&#123;# @strict #&#125;</code> to declare a <em>closed prop set</"
"em> — every prop is listed via <code>@prop</code>. The detail page shows a "
"<code>@strict</code> badge, and the linter turns two things into errors: an "
"undocumented <code>&lt;c-vars&gt;</code> prop, and a stray <code>&#123;"
"&#123; attrs &#125;&#125;</code> (which would let arbitrary attributes "
"through, contradicting the closed set)."
msgstr ""
"Gehitu <code>&#123;# @strict #&#125;</code> <em>prop-multzo itxi bat</em> "
"deklaratzeko — prop bakoitza <code>@prop</code> bidez zerrendatzen da. "
"Xehetasun-orriak <code>@strict</code> bereizgarria erakusten du, eta "
"linterrak bi gauza errore bihurtzen ditu: dokumentatu gabeko <code>&lt;c-"
"vars&gt;</code> prop bat, eta galdutako <code>&#123;&#123; attrs &#125;&#125;"
"</code> bat (nahi bezalako atributuak pasatzen utziko lituzkeena, multzo "
"itxiaren aurka)."

#: templates/django_cotton_gallery/docs.html:295
msgid "Intentionally unused (<code>@ignore-unused</code>)"
msgstr "Nahita erabili gabe (<code>@ignore-unused</code>)"

#: templates/django_cotton_gallery/docs.html:296
msgid ""
"Insights flags <em>zombies</em> — components nothing references (when "
"scanning is on). Add <code>&#123;# @ignore-unused #&#125;</code> to a "
"component that's deliberately unreferenced (a library component, a WIP) so "
"it's excluded from the zombie list. Shows an <code>@ignore-unused</code> "
"badge on the detail page."
msgstr ""
"Insights-ek <em>zonbiak</em> markatzen ditu — ezerk erreferentziatzen ez "
"dituen osagaiak (eskaneatzea piztuta dagoenean). Gehitu <code>&#123;# "
"@ignore-unused #&#125;</code> nahita erreferentziarik gabe dagoen osagai "
"bati (liburutegi-osagai bat, WIP bat) zonbi-zerrendatik kanpo uzteko. "
"<code>@ignore-unused</code> bereizgarria erakusten du xehetasun-orrian."

#: templates/django_cotton_gallery/docs.html:305
msgid ""
"Every component detail page is a live playground. Beyond the props panel, "
"several features make iteration faster:"
msgstr ""
"Konponente-xehetasunen orri bakoitza zuzeneko playground bat da. Props "
"panelaz haratago, hainbat funtzioak iterazioa azkartzen dute:"

#: templates/django_cotton_gallery/docs.html:307
msgid "Preview isolation"
msgstr "Aurrebistaren isolamendua"

#: templates/django_cotton_gallery/docs.html:308
msgid ""
"Every component renders in a <strong>document of its own</strong> — on the "
"detail page, in both compare panels and in each index card. The gallery's "
"CSS cannot reach it, a <code>position: fixed</code> modal stays inside its "
"preview instead of covering the page, and the scripts a component ships with "
"actually run. Media queries fire on the stage width, which is what makes the "
"viewport switcher more than decoration."
msgstr ""
"Osagai bakoitza <strong>bere dokumentu propioan</strong> errendatzen da: "
"xehetasun-orrian, konparazio-panel bietan eta indizeko txartel bakoitzean. "
"Galeriaren CSSak ezin du hara iritsi, <code>position: fixed</code> duen "
"modal bat bere aurrebistaren barruan geratzen da orria estali beharrean, eta "
"osagaiak dakartzan script-ak benetan exekutatzen dira. Media query-ek "
"eszenaren zabalerari erantzuten diote, eta horrek viewport-hautatzailea "
"apaingarri hutsa baino gehiago bihurtzen du."

#: templates/django_cotton_gallery/docs.html:309
msgid ""
"Index cards drop their frame once they scroll well out of view and rebuild "
"it on the way back — a large catalog does not keep one JS runtime alive per "
"component."
msgstr ""
"Indizeko txartelek beren markoa baztertzen dute ikusmenetik nahikoa "
"urruntzen direnean, eta itzultzean berreraiki egiten dute: katalogo handi "
"batek ez du JS runtime bat bizirik mantentzen osagai bakoitzeko."

#: templates/django_cotton_gallery/docs.html:311
msgid "Preview height"
msgstr "Aurrebistaren altuera"

#: templates/django_cotton_gallery/docs.html:312
msgid ""
"Drag the <strong>bottom edge</strong> of the preview to size it, or focus "
"the grip and use the arrow keys (hold Shift for larger steps). A component "
"built for a screen — a modal, a drawer — contributes nothing to its own "
"content height, so there is nothing to measure and the gallery does not "
"guess one. Your height lasts while you stay on the component."
msgstr ""
"Arrastatu aurrebistaren <strong>beheko ertza</strong> tamaina emateko, edo "
"fokatu heldulekua eta erabili gezi-teklak (Shift sakatuta, urrats "
"handiagoak). Pantaila baterako diseinatutako osagai batek —modal bat, alboko "
"panel bat— ez dio ezer ematen bere eduki-altuerari; beraz, ez dago zer "
"neurturik eta galeriak ez du asmatzen. Zure altuera mantendu egiten da "
"osagaian jarraitzen duzun bitartean."

#: templates/django_cotton_gallery/docs.html:315
msgid ""
"Switch the preview into a grid that renders <strong>every combination</"
"strong> of the component's discrete props at once. The first two enum or "
"boolean props become the Y/X axes; every other prop is read from the "
"controls panel and held the same across cells, so changing one there "
"rebuilds the grid. Useful for QA, visual regression, and seeing the whole "
"API at a glance."
msgstr ""
"Aldatu aurrebista sareta batera, osagaiaren prop diskretuen "
"<strong>konbinazio guztiak</strong> aldi berean errendatzen dituena. Lehen "
"bi enum edo boolean prop-ak Y/X ardatzak bihurtzen dira; gainerako prop-ak "
"kontrol-paneletik irakurtzen dira eta berdin mantentzen dira gelaxka "
"guztietan, beraz han bat aldatzeak sareta berreraikitzen du. Erabilgarria "
"QArako, erregresio bisualerako eta API osoa begirada bakar batean ikusteko."

#: templates/django_cotton_gallery/docs.html:316
msgid ""
"Toggle via the <strong>View</strong> switcher in the preview toolbar (single-"
"frame icon ↔ grid icon). Cells lazy-load via IntersectionObserver so dense "
"matrices don't fire 30 fetches at once."
msgstr ""
"Aldatu aurrebistaren tresna-barrako <strong>Ikusi</strong> hautatzailearen "
"bidez (marko bakarreko ikonoa ↔ saretaren ikonoa). Gelaxkak "
"IntersectionObserver bidez kargatzen dira, beraz, matrize trinkoek ez dute "
"aldi berean 30 eskaera abiarazten."

#: templates/django_cotton_gallery/docs.html:319
msgid ""
"The <strong>Bg</strong> bar in the preview toolbar switches the backdrop "
"between checkered, white, dark, and brand. Hit <strong>Edit</strong> to turn "
"the last three swatches into color pickers and recolour them to your app's "
"theme — the choice previews live and is only saved on <strong>Done</strong> "
"(persisted in <code>localStorage</code>); <strong>Reset</strong> restores "
"the defaults."
msgstr ""
"Aurrebistaren tresna-barrako <strong>Bg</strong> barrak atzeko planoa "
"aldatzen du laukien, zuriaren, ilunaren eta markaren artean. Sakatu "
"<strong>Editatu</strong> azken hiru swatch-ak kolore-hautatzaile bihurtzeko "
"eta zure aplikazioaren gaira birkoloreatzeko — hautaketa zuzenean "
"aurreikusten da eta <strong>Eginda</strong> sakatzean bakarrik gordetzen da "
"(<code>localStorage</code>-n gordeta); <strong>Reset</strong>-ek lehenetsiak "
"berrezartzen ditu."

#: templates/django_cotton_gallery/docs.html:321
msgid "Shareable URL state"
msgstr "URL egoera partekagarria"

#: templates/django_cotton_gallery/docs.html:322
msgid ""
"Every change in the controls panel writes the non-default values to the URL "
"via <code>history.replaceState</code>. Copy the URL, send it, and the "
"recipient lands on the same component with the exact same configuration — no "
"description needed for bug reports or design reviews."
msgstr ""
"Kontrolen panelaren aldaketa bakoitzak lehenetsiak ez diren balioak URLan "
"idazten ditu <code>history.replaceState</code> bidez. Kopiatu URLa, bidali "
"eta hartzaileak osagai bera ireki dezake konfigurazio berarekin — ez da "
"deskribapenik behar akats-txostenetarako edo diseinu-berrikuspenetarako."

#: templates/django_cotton_gallery/docs.html:329
msgid "Pass-through attrs control"
msgstr "<<Pass-through>> attrs kontrola"

#: templates/django_cotton_gallery/docs.html:330
msgid ""
"Components whose body uses <code>&#123;&#123; attrs &#125;&#125;</code> or "
"<code>:attrs=\"attrs\"</code> accept arbitrary HTML attributes that aren't "
"declared as <code>&lt;c-vars&gt;</code> props — <code>disabled</code>, "
"<code>id</code>, <code>data-*</code>, <code>aria-*</code>, <code>style</"
"code>, Alpine <code>x-*</code> directives, HTMX <code>hx-*</code> "
"attributes, etc. The gallery auto-detects this and shows an <strong>Extra "
"attributes</strong> input below the declared props."
msgstr ""
"<code>&#123;&#123; attrs &#125;&#125;</code> edo <code>:attrs=\"attrs\"</"
"code> erabiltzen duten osagaiek <code>&lt;c-vars&gt;</code>-ekin deklaratuta "
"ez dauden HTML atributu arbitrarioak onartzen dituzte — <code>disabled</"
"code>, <code>id</code>, <code>data-*</code>, <code>aria-*</code>, "
"<code>style</code>, Alpine <code>x-*</code> direktibak, HTMX <code>hx-*</"
"code> atributuak, etab. Galeriak automatikoki hautematen du eta "
"<strong>Extra attributes</strong> sarrera erakusten du deklaratutako propsen "
"azpian."

#: templates/django_cotton_gallery/docs.html:331
msgid ""
"Type to filter the suggestion popover. <kbd>↓</kbd>/<kbd>↑</kbd> to "
"navigate, <kbd>Tab</kbd> or <kbd>Enter</kbd> to insert the highlighted "
"token. Tokens with <code>=\"\"</code> park the caret inside the quotes so "
"you can type the value immediately. Whatever you type lands literally on the "
"rendered HTML."
msgstr ""
"Idatzi iradokizun-popoverra iragazteko. <kbd>↓</kbd>/<kbd>↑</kbd> "
"nabigatzeko, <kbd>Tab</kbd> edo <kbd>Enter</kbd> nabarmendutako tokena "
"txertatzeko. <code>=\"\"</code> duten tokenek kurtsorea komaen artean uzten "
"dute, balioa berehala idatz dezazun. Idazten duzuna literalki txertatzen da "
"errenderizatutako HTMLan."

#: templates/django_cotton_gallery/docs.html:332
msgid ""
"<strong>Heads up</strong>: <code>class</code> may duplicate when the "
"component's root element already declares one — HTML5 keeps the first "
"<code>class</code> attribute and ignores the rest. Use <code>style</code>, "
"<code>data-*</code>, or any non-conflicting attribute for visual overrides."
msgstr ""
"<strong>Adi</strong>: <code>class</code> bikoiztu daiteke osagaiaren erro-"
"elementuak dagoeneko bat deklaratzen badu — HTML5-ek lehenengo <code>class</"
"code> atributua gordetzen du eta gainerakoak baztertzen ditu. Erabili "
"<code>style</code>, <code>data-*</code> edo gatazkarik gabeko beste edozein "
"atributu ikusmen-gainjartzeetarako."

#: templates/django_cotton_gallery/docs.html:334
msgid "Sidebar typeahead"
msgstr "Alboko barraren autoosaketa"

#: templates/django_cotton_gallery/docs.html:335
msgid ""
"Press <kbd>/</kbd> from anywhere to focus the search. Start typing — a "
"dropdown appears with name + path + description for every match. Hit "
"<kbd>Tab</kbd> to autocomplete the input with the first match (or with "
"whatever suggestion you've focused via <kbd>↓</kbd>). <kbd>Enter</kbd> "
"activates the first match; <kbd>Esc</kbd> clears."
msgstr ""
"Sakatu <kbd>/</kbd> edozein lekutik bilaketa fokuratzeko. Idazten hasi — bat "
"datorrena bakoitzeko izena + bidea + deskribapena dituen menua agertzen da. "
"Sakatu <kbd>Tab</kbd> sarrera lehen bat datorrenarekin autoosatzeko (edo "
"<kbd>↓</kbd> bidez fokuratu duzun iradokizunarekin). <kbd>Enter</kbd>-ek "
"lehen bat datorrena aktibatzen du; <kbd>Esc</kbd>-ek garbitzen du."

#: templates/django_cotton_gallery/docs.html:337
msgid "Language-aware syntax highlighting"
msgstr "Lengoaiaren araberako sintaxi-nabarmentzea"

#: templates/django_cotton_gallery/docs.html:338
#, python-format
msgid ""
"The Source tab, the Cotton-tag preview, and the live editors (slot textarea "
"+ extra-attrs field) all colour the full template stack: HTML tags, Cotton "
"component names (<code>&lt;c-…&gt;</code>), Django <code>&#123;%%&nbsp;"
"%%&#125;</code> / <code>&#123;&#123;&nbsp;&#125;&#125;</code> blocks and "
"filters, HTMX (<code>hx-*</code>) and Alpine (<code>x-*</code> / <code>@</"
"code> / <code>:</code>) attributes — with the Alpine value tokenised as "
"JavaScript — embedded <code>&lt;script&gt;</code> JS and <code>&lt;style&gt;"
"</code> CSS, and the <code>&#123;# @… #&#125;</code> annotation DSL. The "
"slot editor uses an overlay technique; the attrs field is a "
"<code>contenteditable</code> div so the cursor sits on top of the colored "
"text directly."
msgstr ""
"Iturburu-fitxak, Cotton tag-aren aurrebistak eta zuzeneko editoreek (slot-"
"aren textarea + atributu-editorea) txantiloi-pila osoa koloreztatzen dute: "
"HTML etiketak, Cotton osagaien izenak (<code>&lt;c-…&gt;</code>), Django "
"<code>&#123;%%&nbsp;%%&#125;</code> / <code>&#123;&#123;&nbsp;&#125;&#125;</"
"code> blokeak eta iragazkiak, HTMX (<code>hx-*</code>) eta Alpine (<code>x-"
"*</code> / <code>@</code> / <code>:</code>) atributuak — Alpine balioa "
"JavaScript gisa tokenizatuta — <code>&lt;script&gt;</code> JS eta <code>&lt;"
"style&gt;</code> CSS kapsulatuak, eta <code>&#123;# @… #&#125;</code> "
"oharpen-DSLa. Slot-editoreak overlay teknika erabiltzen du; atributu-eremua "
"<code>contenteditable</code> bat da, kurtsorea koloreztatutako testuaren "
"gainean egoteko."

#: templates/django_cotton_gallery/docs.html:340
msgid "CSS autocomplete inside style attributes"
msgstr "CSS autoosatzea style atributuetan"

#: templates/django_cotton_gallery/docs.html:341
msgid ""
"When the caret enters a <code>style=\"…\"</code> attribute, the popover "
"switches from HTML-attribute suggestions to CSS-aware ones. It detects three "
"contexts:"
msgstr ""
"Kurtsorea <code>style=\"…\"</code> atributu batean sartzen denean, popover-"
"ak HTML-atributuen iradokizunetatik CSS-arenetara aldatzen du. Hiru "
"testuinguru detektatzen ditu:"

#: templates/django_cotton_gallery/docs.html:343
msgid ""
"<strong>Property name</strong> after <code>;</code> or at the start — "
"suggests <code>display</code>, <code>padding</code>, <code>color</code>, etc."
msgstr ""
"<strong>Propietatearen izena</strong> <code>;</code>-ren ondoren edo "
"hasieran — <code>display</code>, <code>padding</code>, <code>color</code>, "
"etab. iradokitzen ditu."

#: templates/django_cotton_gallery/docs.html:344
msgid ""
"<strong>Property value</strong> after <code>:</code> — suggests keyword "
"values for the current property (<code>flex</code>, <code>none</code>…), "
"color names, or shorthand pieces (e.g. <code>border: 1px solid red</code> "
"classifies tokens as you type so it only offers what's missing)."
msgstr ""
"<strong>Propietatearen balioa</strong> <code>:</code>-ren ondoren — uneko "
"propietatearen keyword balioak (<code>flex</code>, <code>none</code>…), "
"kolore-izenak edo shorthand zatiak iradokitzen ditu (adib. <code>border: 1px "
"solid red</code>-ek tokenak sailkatzen ditu idazten ari zarenean, beraz "
"falta dena soilik eskaintzen du)."

#: templates/django_cotton_gallery/docs.html:345
msgid ""
"<strong>Length unit</strong> after a number — typing <code>2</code> offers "
"<code>px</code>/<code>rem</code>/<code>vh</code>/<code>dvh</code>/etc; "
"typing <code>2d</code> filters to <code>2dvh</code>/<code>2dvw</code> "
"(matching prefix)."
msgstr ""
"<strong>Luzera-unitatea</strong> zenbaki baten ondoren — <code>2</code> "
"idazteak <code>px</code>/<code>rem</code>/<code>vh</code>/<code>dvh</code>/"
"etab. eskaintzen ditu; <code>2d</code> idazteak <code>2dvh</code>/"
"<code>2dvw</code>-ra iragazten du (aurrizki bat etortzea)."

#: templates/django_cotton_gallery/docs.html:348
msgid "Maximize editor modal"
msgstr "Editorearen modal maximizatua"

#: templates/django_cotton_gallery/docs.html:349
msgid ""
"Both the slot textarea and the extra-attrs field have a maximize button (the "
"diagonal-arrows icon) that opens the editor in a full-screen modal. The "
"modal preserves the editor's contents, caret position, and bindings — "
"autocomplete, syntax highlight, formatter, all keep working. The header has "
"Format and Reset buttons; the footer shows live char/line counts and "
"keyboard shortcuts. Press <kbd>Esc</kbd> or click the backdrop to close."
msgstr ""
"Slot textarea-k eta extra-attrs eremuak biek dute maximizatzeko botoia (gezi "
"diagonalen ikonoa) editorea pantaila osoko modal batean irekitzen duena. "
"Modalak editorearen edukia, kurtsorearen posizioa eta bindingak gordetzen "
"ditu — autocomplete, sintaxi-nabarmentzea, formateadorea, dena funtzionatzen "
"jarraitzen du. Goiburuak Format eta Reset botoiak ditu; oinak karaktere/"
"lerro-zenbaketak eta teklatuko lasterbideak zuzenean erakusten ditu. Sakatu "
"<kbd>Esc</kbd> edo egin klik atzealdean ixteko."

#: templates/django_cotton_gallery/docs.html:351
msgid "Sidebar collapse to rail"
msgstr "Tolestu alboko barra railera"

#: templates/django_cotton_gallery/docs.html:352
msgid ""
"On desktop, a small toggle on the sidebar's right edge collapses it to a "
"4rem icon rail (logo + Empezar + Documentación + theme/lang/github). The "
"component tree hides — to navigate components, expand again. The state "
"persists across sessions via <code>localStorage</code>, applied before first "
"paint to avoid a layout flash."
msgstr ""
"Mahaigainean, alboko barraren eskuineko ertzeko etengailu txiki batek 4rem-"
"eko ikono-erraila bihurtzen du (logo + Empezar + Documentación + gaia/"
"hizkuntza/github). Osagaien zuhaitza ezkutatzen da — osagaietan nabigatzeko, "
"hedatu berriro. Egoera saioen artean iraunkortzen da <code>localStorage</"
"code> bidez, lehen errendatzearen aurretik aplikatuta diseinu-flash bat "
"saihesteko."

#: templates/django_cotton_gallery/docs.html:358
msgid ""
"Strings in filter values are quoted (<code>default:\"primary\"</code>). "
"Numbers and booleans are bare (<code>default:5</code>, <code>default:False</"
"code>)."
msgstr ""
"Iragazki-balioetako kateak komatxoartean daude (<code>default:\"primary\"</"
"code>). Zenbakiak eta booleanak biluzik daude (<code>default:5</code>, "
"<code>default:False</code>)."

#: templates/django_cotton_gallery/docs.html:359
msgid ""
"If <code>&lt;c-vars&gt;</code> uses <code>:prop</code> (dynamic), the "
"matching <code>@prop</code> MUST also start with <code>:</code>."
msgstr ""
"<code>&lt;c-vars&gt;</code>-ek <code>:prop</code> erabiltzen badu "
"(dinamikoa), bat datorren <code>@prop</code>-ek ere <code>:</code>-rekin "
"hasi BEHAR du."

#: templates/django_cotton_gallery/docs.html:360
msgid ""
"<code>| required</code> only takes effect when there's no <code>| default:</"
"code>. If both are present, default wins."
msgstr ""
"<code>| required</code> soilik <code>| default:</code> ez dagoenean "
"aplikatzen da. Biak presente badaude, default-ek irabazten du."

#: templates/django_cotton_gallery/docs.html:361
msgid ""
"Annotations are plain Django comments — Cotton and Django ignore them at "
"render time. Only the gallery's parser reads them."
msgstr ""
"Oharrak Django iruzkin hutsak dira — Cotton eta Django-k ezikusi egiten "
"dituzte errendatze-garaian. Galeriaren parser-ak soilik irakurtzen ditu."

#: templates/django_cotton_gallery/get-started.html:11
msgid "From zero to your first component"
msgstr "Zerotik zure lehen osagairaino"

#: templates/django_cotton_gallery/get-started.html:13
#, python-format
msgid ""
"Drop the components into a Django project in 90 seconds. Three steps, three "
"copy-and-pasteable snippets. Once you're up and running, head to <a "
"href=\"%(url)s\">Documentation</a> for the full configuration and annotation "
"reference."
msgstr ""
"Sartu osagaiak Django proiektu batean 90 segundotan. Hiru urrats, hiru "
"kopiatu-eta-itsasteko zatiki. Martxan zaudenean, joan <a "
"href=\"%(url)s\">Dokumentaziora</a> konfigurazio eta anotazio erreferentzia "
"osorako."

#: templates/django_cotton_gallery/get-started.html:20
#: templates/django_cotton_gallery/get-started.html:28
msgid "1. Install"
msgstr "1. Instalatu"

#: templates/django_cotton_gallery/get-started.html:21
#: templates/django_cotton_gallery/get-started.html:58
msgid "2. Use a component"
msgstr "2. Erabili osagai bat"

#: templates/django_cotton_gallery/get-started.html:22
#: templates/django_cotton_gallery/get-started.html:72
msgid "3. Make your own"
msgstr "3. Sortu zurea"

#: templates/django_cotton_gallery/get-started.html:23
#: templates/django_cotton_gallery/get-started.html:88
msgid "4. Enable language switching (optional)"
msgstr "4. Gaitu hizkuntza-aldaketa (aukerakoa)"

#: templates/django_cotton_gallery/get-started.html:29
msgid ""
"Install both apps with pip, register them in <code>settings.py</code>, then "
"mount the gallery URLs behind a <code>DEBUG</code> guard. Plug and play — no "
"other configuration needed for first run."
msgstr ""
"Instalatu bi appak pip-ekin, erregistratu <code>settings.py</code>-n, eta "
"muntatu galeriaren URLak <code>DEBUG</code> guard baten atzean. Plug and "
"play — ez da konfigurazio gehiagorik behar lehen exekuziorako."

#: templates/django_cotton_gallery/get-started.html:41
msgid ""
"Then mount the gallery URLs in your project's <code>urls.py</code> — gated "
"by <code>DEBUG</code> so the routes never reach production:"
msgstr ""
"Ondoren muntatu galeriaren URLak zure proiektuaren <code>urls.py</code>-n — "
"<code>DEBUG</code>-ek babestuta, ibilbideek ekoizpenera inoiz ez iristeko:"

#: templates/django_cotton_gallery/get-started.html:53
msgid ""
"Visit <code>/gallery/</code> in your browser. The gallery is a development "
"tool — leaving the include guarded by <code>DEBUG</code> keeps it off in "
"production by construction."
msgstr ""
"Ireki <code>/gallery/</code> zure nabigatzailean. Galeria garapen-tresna bat "
"da — <code>DEBUG</code>-ekin babestuta uzteak ekoizpenean itzalita "
"mantentzen du eraikuntzaz."

#: templates/django_cotton_gallery/get-started.html:54
#, python-format
msgid ""
"Django Cotton's regex compiler runs before Django's template engine and "
"converts <code>&lt;c-foo /&gt;</code> tags into <code>&#123;%% include "
"%%&#125;</code> calls. The <code>COTTON_SNAKE_CASED_NAMES = False</code> "
"setting keeps tag names kebab-case so file paths like <code>atoms/ui/button."
"html</code> map to <code>&lt;c-atoms.ui.button /&gt;</code> directly."
msgstr ""
"Django Cotton-en regex konpiladorea Django-ren template motorraren aurretik "
"exekutatzen da eta <code>&lt;c-foo /&gt;</code> etiketak <code>&#123;%% "
"include %%&#125;</code> deietara bihurtzen ditu. "
"<code>COTTON_SNAKE_CASED_NAMES = False</code> ezarpenak etiketa-izenak kebab-"
"case-an mantentzen ditu, beraz <code>atoms/ui/button.html</code> bezalako "
"bideak <code>&lt;c-atoms.ui.button /&gt;</code>-ra zuzenean mapatzen dira."

#: templates/django_cotton_gallery/get-started.html:59
msgid ""
"Render any component by its kebab-case path. The folder structure becomes "
"the dotted tag name — that's the whole convention."
msgstr ""
"Errendatu edozein osagai bere kebab-case bidearen bidez. Karpeta-egitura "
"puntudun etiketa-izena bihurtzen da — hori da konbentzio osoa."

#: templates/django_cotton_gallery/get-started.html:68
msgid ""
"That's it — your components are live in the gallery. Whatever stack they "
"need (Tailwind, HTMX, Alpine, your own bundle…) hooks in through "
"<code>DJANGO_COTTON_GALLERY_EXTRA_CSS</code> / <code>_EXTRA_JS</code> in "
"settings, or the <code>_extra_head.html</code> partial in your templates "
"dir. Browse the sidebar to see your components live, with their props panels."
msgstr ""
"Hori da — zure osagaiak galerian zuzenean daude. Behar duten edozein stack "
"(Tailwind, HTMX, Alpine, zure bundle propioa…) "
"<code>DJANGO_COTTON_GALLERY_EXTRA_CSS</code> / <code>_EXTRA_JS</code> bidez "
"settings-en, edo zure templates karpetan dagoen <code>_extra_head.html</"
"code> partial-aren bidez konektatzen da. Arakatu alboko barra zure osagaiak "
"zuzenean ikusteko, beren props panelekin."

#: templates/django_cotton_gallery/get-started.html:73
msgid ""
"Drop a new file under <code>templates/cotton/</code>. The gallery picks it "
"up automatically — no registration, no rebuild. Add an <code>@prop</code> "
"annotation comment and the controls panel builds itself."
msgstr ""
"Sartu fitxategi berri bat <code>templates/cotton/</code>-en. Galeriak "
"automatikoki hartzen du — erregistrorik gabe, berreraikitzerik gabe. Gehitu "
"<code>@prop</code> anotazio-iruzkin bat eta kontrol-panela bere kabuz "
"eraikitzen da."

#: templates/django_cotton_gallery/get-started.html:82
msgid ""
"Save the file, restart the server (Cotton caches templates), and your "
"component shows up in the gallery's sidebar with a live preview, an editable "
"<code>name</code> control, and a generated props table."
msgstr ""
"Gorde fitxategia, berrabiarazi zerbitzaria (Cotton-ek txantiloiak gordetzen "
"ditu cache-an), eta zure osagaia galeriaren albo-barran agertzen da zuzeneko "
"aurrebistarekin, <code>name</code> kontrol editagarriarekin, eta sortutako "
"props-taularekin."

#: templates/django_cotton_gallery/get-started.html:83
msgid ""
"<strong>Folder layout is flexible.</strong> Components can live at any depth "
"— <code>cotton/button.html</code>, <code>cotton/button/index.html</code>, "
"<code>cotton/atoms/button.html</code>, or <code>cotton/atoms/button/index."
"html</code> all work. The first folder under <code>cotton/</code> becomes "
"the sidebar category; loose files at the root group under \"Components\". "
"When both <code>&lt;dir&gt;.html</code> and <code>&lt;dir&gt;/index.html</"
"code> exist, the sibling wins (cotton's resolution order)."
msgstr ""
"<strong>Karpeta-egitura malgua da.</strong> Osagaiak edozein sakoneratan "
"bizi daitezke — <code>cotton/button.html</code>, <code>cotton/button/index."
"html</code>, <code>cotton/atoms/button.html</code> edo <code>cotton/atoms/"
"button/index.html</code>, denek funtzionatzen dute. <code>cotton/</code>-ren "
"azpiko lehen karpeta alboko barraren kategoria bihurtzen da; erroan dauden "
"fitxategi solteak \"Osagaiak\"-en azpian taldekatzen dira. <code>&lt;dir&gt;."
"html</code> eta <code>&lt;dir&gt;/index.html</code> biak existitzen "
"direnean, anaiak irabazten du (cotton-en ebazpen-ordena)."

#: templates/django_cotton_gallery/get-started.html:84
#, python-format
msgid ""
"Annotation grammar (types, filters, dynamic props, slots, triggers) is "
"covered in <a href=\"%(url)s#annotations\">Documentation → Annotations</a>. "
"The full list of consumer settings is in <a "
"href=\"%(url)s#configuration\">Documentation → Configuration</a>."
msgstr ""
"Anotazio-gramatika (motak, iragazkiak, props dinamikoak, slot-ak, trigger-"
"ak) <a href=\"%(url)s#annotations\">Dokumentazioa → Anotazioak</a> atalean "
"dago. Erabiltzailearen ezarpenen zerrenda osoa <a "
"href=\"%(url)s#configuration\">Dokumentazioa → Konfigurazioa</a> atalean "
"dago."

#: templates/django_cotton_gallery/get-started.html:90
msgid "Two changes in your project to enable it. First, mount the i18n URLs:"
msgstr "Bi aldaketa zure proiektuan gaitzeko. Lehenik, muntatu i18n URLak:"

#: templates/django_cotton_gallery/get-started.html:101
msgid ""
"Second, add <code>LocaleMiddleware</code> to the middleware stack. Order "
"matters: it must come <strong>after</strong> <code>SessionMiddleware</code> "
"and <strong>before</strong> <code>CommonMiddleware</code>:"
msgstr ""
"Bigarrenik, gehitu <code>LocaleMiddleware</code> middleware-en pilara. "
"Ordena garrantzitsua da: <code>SessionMiddleware</code>-ren <strong>ondoren</"
"strong> eta <code>CommonMiddleware</code>-ren <strong>aurretik</strong> joan "
"behar da:"

#: templates/django_cotton_gallery/get-started.html:113
msgid ""
"Refresh the page and the dropdown shows up in the sidebar with the four "
"supported locales. To expose more or fewer locales, set <code>LANGUAGES</"
"code> in your <code>settings.py</code> — the gallery picks up whatever is "
"configured."
msgstr ""
"Birkargatu orria eta goitibeherakoa alboko barran agertuko da onartzen diren "
"lau locale-ekin. Locale gehiago edo gutxiago erakusteko, ezarri "
"<code>LANGUAGES</code> zure <code>settings.py</code>-n — galeriak "
"konfiguratuta dagoena hartzen du."

#: templates/django_cotton_gallery/index.html:4
msgid "Home"
msgstr "Hasiera"

#: templates/django_cotton_gallery/index.html:10
msgid "Cotton component library"
msgstr "Cotton osagaien liburutegia"

#: templates/django_cotton_gallery/index.html:13
msgid "Production-ready components for"
msgstr "Produkziorako prest dauden osagaiak"

#: templates/django_cotton_gallery/index.html:16
msgid ""
"Stack-agnostic playground for your Cotton components. Every component is "
"annotated, copy-and-pasteable, and themable through your design tokens — "
"bring your own stack (Tailwind, HTMX, Alpine, your own bundle…) and start "
"shipping."
msgstr ""
"Stack-agnostiko playground-a zure Cotton osagaietarako. Osagai bakoitza "
"anotatuta dago, kopia eta itsasteko prest, eta zure design tokenen bidez "
"tematizagarria — ekarri zure stack-a (Tailwind, HTMX, Alpine, zure bundle "
"propioa…) eta hasi argitaratzen."

#: templates/django_cotton_gallery/index.html:27
msgid "Browse components"
msgstr "Ikusi osagaiak"

#: templates/django_cotton_gallery/index.html:31
msgid "Read the docs"
msgstr "Irakurri dokumentazioa"

#: templates/django_cotton_gallery/index.html:66
msgid "Cotton folder not found"
msgstr "Ez da cotton karpeta aurkitu"

#: templates/django_cotton_gallery/index.html:68
#, python-format
msgid ""
"The gallery is looking for components in <code>%(path)s</code>, but that "
"folder doesn't exist yet."
msgstr ""
"Galeria <code>%(path)s</code>-en osagaiak bilatzen ari da, baina karpeta "
"hori ez dago oraindik."

#: templates/django_cotton_gallery/index.html:71
msgid "Two ways to fix it:"
msgstr "Konpontzeko bi modu:"

#: templates/django_cotton_gallery/index.html:73
#, python-format
msgid ""
"Create the folder at <code>%(subfolder)s/</code> inside one of your "
"<code>TEMPLATES['DIRS']</code> entries (or any installed app's "
"<code>templates/</code> folder when <code>APP_DIRS</code> is on) and drop a "
"component file in it."
msgstr ""
"Sortu <code>%(subfolder)s/</code> karpeta zure <code>TEMPLATES['DIRS']</"
"code> sarreraren batean (edo instalatutako edozein app-en <code>templates/</"
"code> karpetan <code>APP_DIRS</code> aktibo dagoenean) eta jarri osagai-"
"fitxategi bat bertan."

#: templates/django_cotton_gallery/index.html:74
#, python-format
msgid ""
"If your components live under a different folder name, change the gallery's "
"lookup by setting <code>COTTON_DIR = '...'</code> in your <code>settings.py</"
"code>. The default is <code>'%(subfolder)s'</code> — set it to whatever name "
"your components folder uses."
msgstr ""
"Zure osagaiak beste karpeta-izen batean bizi badira, aldatu galeriaren "
"bilaketa <code>COTTON_DIR = '...'</code> ezarriz zure <code>settings.py</"
"code>-n. Lehenetsia <code>'%(subfolder)s'</code> da — ezarri zure osagaien "
"karpetak erabiltzen duen izenera."

#: templates/django_cotton_gallery/index.html:78
msgid "No components yet"
msgstr "Oraindik ez dago osagairik"

#: templates/django_cotton_gallery/index.html:80
#, python-format
msgid ""
"Drop your first Cotton component into <code>%(path)s</code> and the gallery "
"will pick it up automatically — no restart needed."
msgstr ""
"Utzi zure lehen Cotton osagaia <code>%(path)s</code>-en eta galeria "
"automatikoki hartuko du — ez da berrabiarazi behar."

#: templates/django_cotton_gallery/index.html:85
msgid "Example layout:"
msgstr "Layout-aren adibidea:"

#: templates/django_cotton_gallery/index.html:98
msgid ""
"Add <code>@prop</code> annotation headers at the top of each file so the "
"gallery can build interactive controls automatically."
msgstr ""
"Gehitu <code>@prop</code> anotazio-goiburuak fitxategi bakoitzaren hasieran "
"galeria-ak kontrol interaktiboak automatikoki eraiki ditzan."

#: templates/django_cotton_gallery/index.html:99
msgid "Read the documentation →"
msgstr "Irakurri dokumentazioa →"

#: templates/django_cotton_gallery/index.html:112
msgid "Optional: enable language switching"
msgstr "Aukerakoa: gaitu hizkuntza-aldaketa"

#: templates/django_cotton_gallery/index.html:113
msgid ""
"The gallery is translated into English, Spanish, Basque, and French — but "
"the language dropdown only appears when your project mounts Django's i18n "
"URLs and <code>LocaleMiddleware</code>. Add both in your <code>urls.py</"
"code> and <code>settings.py</code> to enable it."
msgstr ""
"Galeria ingelesera, gaztelaniara, euskarara eta frantsesera itzulita dago — "
"baina hizkuntza-goitibeherakoa zure proiektuak Django-ren i18n URLak eta "
"<code>LocaleMiddleware</code> muntatzen dituenean soilik agertzen da. Gehitu "
"biak zure <code>urls.py</code>-n eta <code>settings.py</code>-n gaitzeko."

#: templates/django_cotton_gallery/index.html:115
msgid "See the i18n setup steps →"
msgstr "Ikusi i18n konfigurazioaren urratsak →"

#: templates/django_cotton_gallery/insights.html:8
msgid "Catalog insights"
msgstr "Katalogoaren argibideak"

#: templates/django_cotton_gallery/insights.html:10
msgid ""
"Health and usage signals across your component catalog. Lint, annotation "
"coverage and deprecation come from the catalog itself; zombies and most-"
"referenced metrics require scanning your project's templates and are opt-in."
msgstr ""
"Zure osagaien katalogoaren osasun eta erabilera seinaleak. Lint-a, oharpenen "
"estaldura eta zaharkitzea katalogotik bertatik datoz; zonbiak eta gehien "
"erreferentziatutako metrikek zure proiektuaren txantiloiak eskaneatzea behar "
"dute eta aukerakoak dira."

#: templates/django_cotton_gallery/insights.html:16
msgid "Catalog"
msgstr "Katalogoa"

#: templates/django_cotton_gallery/insights.html:18
msgid "component"
msgid_plural "components"
msgstr[0] "osagai"
msgstr[1] "osagai"

#: templates/django_cotton_gallery/insights.html:30
msgid "Lint health"
msgstr "Lint osasuna"

#: templates/django_cotton_gallery/insights.html:31
msgid "How is this score computed?"
msgstr "Nola kalkulatzen da puntuazio hau?"

#: templates/django_cotton_gallery/insights.html:37
msgid ""
"<strong>Higher is better.</strong> Starts at <strong>100</strong> (clean "
"catalog, no annotation issues) and subtracts <strong>5 per error</strong> "
"and <strong>1 per warning</strong>, floored at <strong>0</strong>. "
"<strong>Hints don't subtract</strong> — they're heuristic checks (e.g. "
"context-processor variables) that may produce false positives. So 100 = "
"perfect, 0 = lots of issues. Click \"Open lint report\" to see exactly which "
"rules fired."
msgstr ""
"<strong>Altuagoa hobe.</strong> <strong>100</strong>etik hasten da (katalogo "
"garbia, oharpen arazorik gabe) eta <strong>5 errore bakoitzeko</strong> eta "
"<strong>1 abisu bakoitzeko</strong> kentzen du, <strong>0</strong>n "
"geldituta. <strong>Iradokizunek ez dute kentzen</strong> — testuinguru-"
"prozesatzaileen aldagaiak bezalako heuristikoak dira eta faltsu positiboak "
"eman ditzakete. Beraz 100 = ezin hobea, 0 = arazo asko."

#: templates/django_cotton_gallery/insights.html:44
msgid "clean ✓"
msgstr "garbia ✓"

#: templates/django_cotton_gallery/insights.html:45
msgid "healthy"
msgstr "osasuntsu"

#: templates/django_cotton_gallery/insights.html:46
msgid "needs attention"
msgstr "arreta behar du"

#: templates/django_cotton_gallery/insights.html:47
msgid "many issues"
msgstr "arazo asko"

#: templates/django_cotton_gallery/insights.html:59
msgid ""
"100 = clean · −5 / error · −1 / warning · hints don't subtract · higher is "
"better"
msgstr ""
"100 = garbi · −5 / errore · −1 / abisu · iradokizunek ez dute kentzen · "
"altuagoa hobe"

#: templates/django_cotton_gallery/insights.html:60
msgid "Open lint report →"
msgstr "Lint txostena ireki →"

#: templates/django_cotton_gallery/insights.html:65
msgid "Annotation coverage"
msgstr "Oharpenen estaldura"

#: templates/django_cotton_gallery/insights.html:66
msgid "What does each row mean?"
msgstr "Zer esan nahi du errenkada bakoitzak?"

#: templates/django_cotton_gallery/insights.html:72
msgid ""
"<strong>How many of your components carry which kind of annotation.</strong> "
"Higher = the gallery has more metadata to render rich previews and the "
"linter has more material to check. <strong>Documented</strong>: have at "
"least one <code>@description</code> or <code>@prop</code>. <strong>With "
"props</strong>: declare at least one <code>@prop</code>. <strong>With slots</"
"strong>: declare at least one <code>@slot</code>. <strong>Accept attrs</"
"strong>: render <code>&#123;&#123; attrs &#125;&#125;</code> so callers can "
"pass extra HTML attributes through."
msgstr ""
"<strong>Zenbat osagaik daramaten oharpen-mota bakoitza.</strong> Altuagoa = "
"galeriak metadatu gehiago du preview aberatsak errendatzeko eta linterrak "
"material gehiago du egiaztatzeko. <strong>Dokumentatua</strong>: gutxienez "
"<code>@description</code> edo <code>@prop</code> bat dute. <strong>Prop-"
"ekin</strong>: gutxienez <code>@prop</code> bat deklaratzen dute. "
"<strong>Slot-ekin</strong>: gutxienez <code>@slot</code> bat deklaratzen "
"dute. <strong>Attrs onartzen</strong>: <code>&#123;&#123; attrs &#125;&#125;"
"</code> errendatzen dute, deitzaileek HTML atributu gehigarriak pasa ahal "
"izan ditzaten."

#: templates/django_cotton_gallery/insights.html:76
#, python-format
msgid ""
"%% of components that carry each kind of annotation. Higher is better — more "
"metadata to drive the gallery's controls and lint checks."
msgstr ""
"%% anotazio mota bakoitza daramaten osagaiena. Altuagoa hobeagoa da — "
"galeriaren kontrolak eta lint-aren egiaztapenak gidatzeko metadata gehiago."

#: templates/django_cotton_gallery/insights.html:79
msgid "Components that have at least one @description or @prop comment"
msgstr "Gutxienez @description edo @prop iruzkin bat duten osagaiak"

#: templates/django_cotton_gallery/insights.html:79
msgid "Documented"
msgstr "Dokumentatua"

#: templates/django_cotton_gallery/insights.html:84
msgid "Components that declare at least one @prop"
msgstr "Gutxienez @prop bat deklaratzen duten osagaiak"

#: templates/django_cotton_gallery/insights.html:84
msgid "With props"
msgstr "Propsekin"

#: templates/django_cotton_gallery/insights.html:89
msgid "Components that declare at least one @slot"
msgstr "Gutxienez @slot bat deklaratzen duten osagaiak"

#: templates/django_cotton_gallery/insights.html:89
msgid "With slots"
msgstr "Slotekin"

#: templates/django_cotton_gallery/insights.html:94
msgid ""
"Components that render {{ attrs }} so callers can pass extra HTML attributes"
msgstr ""
"{{ attrs }} errendatzen duten osagaiak, deitzaileek HTML atributu "
"gehigarriak pasa ahal izan ditzaten"

#: templates/django_cotton_gallery/insights.html:94
msgid "Accept attrs"
msgstr "Attrs onartzen"

#: templates/django_cotton_gallery/insights.html:103
msgid "Cotton configuration"
msgstr "Cotton-en konfigurazioa"

#: templates/django_cotton_gallery/insights.html:104
msgid "Why does this matter?"
msgstr "Zergatik garrantzitsua da hau?"

#: templates/django_cotton_gallery/insights.html:110
msgid ""
"A snapshot of the two Cotton settings the gallery cares about — "
"<strong>where</strong> it scans for components and <strong>how</strong> "
"Cotton maps your tags to files. Mismatches between your filenames and these "
"settings break previews silently, so this card flags them up front."
msgstr ""
"Galeriak axola dien Cotton-en bi ezarpenen begiratu bat — <strong>non</"
"strong> bilatzen dituen osagaiak eta <strong>nola</strong> Cotton-ek zure "
"tag-ak fitxategiekin lotzen dituen. Zure fitxategien eta ezarpen hauen "
"arteko ez-bat-etortzeak preview-ak isilik hausten ditu, beraz, txartel honek "
"aurretik markatzen ditu."

#: templates/django_cotton_gallery/insights.html:126
msgid "What is COTTON_DIR?"
msgstr "Zer da COTTON_DIR?"

#: templates/django_cotton_gallery/insights.html:131
msgid ""
"Subfolder name (relative to <code>TEMPLATES['DIRS']</code>) where Cotton — "
"and the gallery — look for component files. Default <code>\"cotton\"</code>. "
"Belongs to the Cotton folder convention; the gallery just reads it."
msgstr ""
"Azpikarpetaren izena (<code>TEMPLATES['DIRS']</code>-en erlatiboa) Cotton-ek "
"— eta galeriak — osagai-fitxategiak bilatzen dituen lekuan. Lehenetsia "
"<code>\"cotton\"</code>. Cotton-en karpeta-konbentzioari dagokio; galeriak "
"irakurri besterik ez du egiten."

#: templates/django_cotton_gallery/insights.html:140
msgid "Scanning"
msgstr "Bilatzen"

#: templates/django_cotton_gallery/insights.html:141
msgid "What is being scanned?"
msgstr "Zer ari da bilatzen?"

#: templates/django_cotton_gallery/insights.html:146
msgid ""
"The absolute filesystem path the gallery is currently scanning. If this "
"isn't where you expect your components to live, check your TEMPLATES['DIRS'] "
"and COTTON_DIR settings."
msgstr ""
"Galeria orain bilatzen ari den fitxategi-sistemaren bide absolutua. Hau ez "
"bada zure osagaiak espero dituzun lekua, egiaztatu zure TEMPLATES['DIRS'] "
"eta COTTON_DIR ezarpenak."

#: templates/django_cotton_gallery/insights.html:162
msgid "What does this setting do?"
msgstr "Zer egiten du ezarpen honek?"

#: templates/django_cotton_gallery/insights.html:167
msgid ""
"Cotton's setting that decides how a tag like <code>&lt;c-foo-bar /&gt;</"
"code> maps to a file. With <code>True</code> (Cotton's default) it strips "
"hyphens and looks for <code>foo_bar.html</code>; with <code>False</code> it "
"keeps the hyphen and looks for <code>foo-bar.html</code>. The gallery "
"indexes both styles transparently — pick whichever you prefer and stay "
"consistent across the catalog."
msgstr ""
"Cotton-en ezarpena <code>&lt;c-foo-bar /&gt;</code> bezalako etiketa bat "
"fitxategi batera nola mapatzen den erabakitzen duena. <code>True</code>-"
"rekin (Cotton-en lehenetsia) marrak kentzen ditu eta <code>foo_bar.html</"
"code> bilatzen du; <code>False</code>-rekin marra mantentzen du eta "
"<code>foo-bar.html</code> bilatzen du. Galeriak bi estiloak modu garden "
"batean indexatzen ditu — aukeratu nahiago duzuna eta katalogo osoan "
"sendotasuna mantendu."

#: templates/django_cotton_gallery/insights.html:187
msgid "error component"
msgid_plural "error components"
msgstr[0] "akatsdun osagaia"
msgstr[1] "akatsdun osagaiak"

#: templates/django_cotton_gallery/insights.html:188
msgid "How to fix this"
msgstr "Hau nola konpondu"

#: templates/django_cotton_gallery/insights.html:193
msgid ""
"Cotton transforms <code>-</code> into <code>_</code> when looking up files, "
"but these components have a hyphen in their filename — Cotton can't find "
"them. <strong>Two ways to fix it:</strong> rename the files (<code>form-"
"field.html</code> → <code>form_field.html</code>) <strong>or</strong> set "
"<code>COTTON_SNAKE_CASED_NAMES = False</code> in your <code>settings.py</"
"code> to keep the hyphens."
msgstr ""
"Cotton-ek <code>-</code> <code>_</code>-ra bihurtzen du fitxategiak "
"bilatzean, baina osagai hauek marra dute izen-fitxategian — Cotton-ek ezin "
"ditu aurkitu. <strong>Bi modu konpontzeko:</strong> fitxategiak berrizendatu "
"(<code>form-field.html</code> → <code>form_field.html</code>) <strong>edo</"
"strong> ezarri <code>COTTON_SNAKE_CASED_NAMES = False</code> zure "
"<code>settings.py</code>-n marrak mantentzeko."

#: templates/django_cotton_gallery/insights.html:198
msgid "Affected components:"
msgstr "Eragindako osagaiak:"

#: templates/django_cotton_gallery/insights.html:208
msgid "suboptimal"
msgstr "azpioptimoa"

#: templates/django_cotton_gallery/insights.html:209
msgid "Why suboptimal?"
msgstr "Zergatik azpioptimoa?"

#: templates/django_cotton_gallery/insights.html:214
msgid ""
"Your filenames have no hyphens and <code>COTTON_SNAKE_CASED_NAMES = True</"
"code> — cotton's default. Cotton resolves your tags fine. If you'd rather "
"have kebab-case filenames matching your tags 1:1 (e.g. <code>form-field."
"html</code> → <code>&lt;c-form-field /&gt;</code>), set the setting to "
"<code>False</code>; both styles work."
msgstr ""
"Zure fitxategi-izenek ez dute marrarik eta <code>COTTON_SNAKE_CASED_NAMES = "
"True</code> — cotton-en lehenetsia. Cotton-ek zure etiketak ondo ebazten "
"ditu. Nahiago baduzu kebab-case fitxategi-izenak zure etiketekin 1:1 bat "
"datozkienak (adib. <code>form-field.html</code> → <code>&lt;c-form-field /"
"&gt;</code>), ezarri ezarpena <code>False</code>-ra; bi estiloek "
"funtzionatzen dute."

#: templates/django_cotton_gallery/insights.html:219
#, python-format
msgid ""
"All <strong>%(counter)s</strong> component is correctly named for this "
"configuration — Cotton's snake_case convention is being followed."
msgid_plural ""
"All <strong>%(counter)s</strong> components are correctly named for this "
"configuration — Cotton's snake_case convention is being followed."
msgstr[0] ""
"Osagaia (<strong>%(counter)s</strong>) zuzen izendatuta dago konfigurazio "
"honetarako — Cotton-en snake_case konbentzioa jarraitzen ari da."
msgstr[1] ""
"<strong>%(counter)s</strong> osagaiak zuzen izendatuta daude konfigurazio "
"honetarako — Cotton-en snake_case konbentzioa jarraitzen ari da."

#: templates/django_cotton_gallery/insights.html:224
msgid "optimal"
msgstr "optimoa"

#: templates/django_cotton_gallery/insights.html:225
msgid "Why optimal?"
msgstr "Zergatik optimoa?"

#: templates/django_cotton_gallery/insights.html:230
msgid ""
"Your filenames map 1:1 to Cotton tags (e.g. <code>atoms/form-field.html</"
"code> → <code>&lt;c-atoms.form-field /&gt;</code>). No surprises."
msgstr ""
"Zure fitxategi-izenek 1:1 lotzen dira Cotton tag-ekin (adib. <code>atoms/"
"form-field.html</code> → <code>&lt;c-atoms.form-field /&gt;</code>). "
"Ezustekorik gabe."

#: templates/django_cotton_gallery/insights.html:235
#, python-format
msgid ""
"All <strong>%(counter)s</strong> component maps 1:1 to its Cotton tag. No "
"surprises."
msgid_plural ""
"All <strong>%(counter)s</strong> components map 1:1 to their Cotton tags. No "
"surprises."
msgstr[0] ""
"Osagaia (<strong>%(counter)s</strong>) 1:1 lotzen da bere Cotton tag-arekin. "
"Ezustekorik gabe."
msgstr[1] ""
"<strong>%(counter)s</strong> osagaiek 1:1 lotzen dira beren Cotton tag-ekin. "
"Ezustekorik gabe."

#: templates/django_cotton_gallery/insights.html:251
msgid "No component declares deprecated props."
msgstr "Inolako osagaik ez du prop zaharkiturik adierazten."

#: templates/django_cotton_gallery/insights.html:257
msgid "Coverage gaps"
msgstr "Estaldura hutsuneak"

#: templates/django_cotton_gallery/insights.html:260
msgid ""
"Components missing a top-level @description, or with at least one prop that "
"has no description."
msgstr ""
"@description nagusirik ez duten osagaiak edo deskribapenik gabeko propak "
"dituztenak."

#: templates/django_cotton_gallery/insights.html:268
msgid "Every component and every prop is documented."
msgstr "Osagai eta prop guztiak dokumentatuta daude."

#: templates/django_cotton_gallery/insights.html:274
msgid "External usage — where your components are referenced"
msgstr "Kanpoko erabilera — non erreferentziatzen diren zure osagaiak"

#: templates/django_cotton_gallery/insights.html:275
msgid "How does the scan work?"
msgstr "Nola funtzionatzen du eskaneatzeak?"

#: templates/django_cotton_gallery/insights.html:281
msgid ""
"When opted in, the gallery walks every <code>.html</code> file under your "
"<code>TEMPLATES['DIRS']</code> entries and each app's <code>templates/</"
"code> folder, looking for <code>&lt;c-X.Y /&gt;</code> tags that reference "
"catalog components. The catalog itself (your <code>cotton/</code>) is "
"excluded — the scan only looks at consumer code. Read-only, dev-only, only "
"template paths surface in the UI."
msgstr ""
"Aktibatzen baduzu, galeriak <code>TEMPLATES['DIRS']</code>-en sarrera "
"bakoitzeko eta aplikazio bakoitzaren <code>templates/</code> karpetako "
"<code>.html</code> fitxategi guztiak ibiltzen ditu, katalogoko osagaiak "
"erreferentziatzen dituzten <code>&lt;c-X.Y /&gt;</code> tag-ak bilatuz. "
"Katalogoa bera (zure <code>cotton/</code>) baztertuta dago — eskaneatzeak "
"kontsumitzaile-kodea bakarrik begiratzen du. Soilik irakurtzeko, soilik dev-"
"en, txantiloi-bideak bakarrik agertzen dira UI-an."

#: templates/django_cotton_gallery/insights.html:284
msgid "scanning"
msgstr "eskaneatzen"

#: templates/django_cotton_gallery/insights.html:284
msgid "disabled"
msgstr "desgaituta"

#: templates/django_cotton_gallery/insights.html:286
msgid ""
"Tracks who uses your components from OUTSIDE the catalog (your real pages, "
"layouts, partials). Without this, the gallery only knows about references "
"between catalog components themselves."
msgstr ""
"Zure osagaiak katalogotik KANPO nork erabiltzen dituen jarraitzen du (zure "
"benetako orriak, layout-ak, partial-ak). Hau gabe, galeriak katalogoko "
"osagaien arteko erreferentziak bakarrik ezagutzen ditu."

#: templates/django_cotton_gallery/insights.html:291
msgid "Most referenced"
msgstr "Gehien erreferentziatuak"

#: templates/django_cotton_gallery/insights.html:304
msgid "Nothing references your components yet."
msgstr "Oraindik ezerk ez ditu zure osagaiak erreferentziatzen."

#: templates/django_cotton_gallery/insights.html:309
msgid "Zombies"
msgstr "Zonbiak"

#: templates/django_cotton_gallery/insights.html:312
msgid ""
"Components with zero references — neither inside the catalog nor in your "
"project's templates."
msgstr ""
"Erreferentziarik gabeko osagaiak — ez katalogo barruan, ez zure proiektuaren "
"txantiloietan."

#: templates/django_cotton_gallery/insights.html:320
msgid "Every component is used somewhere — clean catalog."
msgstr "Osagai guztiak nonbait erabiltzen dira — katalogo garbia."

#: templates/django_cotton_gallery/insights.html:327
msgid ""
"Zombies and most-referenced metrics require scanning your project's "
"templates."
msgstr ""
"Zonbiak eta gehien erreferentziatuak metrikek zure proiektuaren txantiloiak "
"eskaneatzea behar dute."

#: templates/django_cotton_gallery/insights.html:328
msgid ""
"The gallery never reads consumer code without consent. Set "
"<code>DJANGO_COTTON_GALLERY_SCAN_EXTERNAL_USERS = True</code> in your Django "
"settings to enable. Read-only, dev-only — only template paths are exposed in "
"the gallery UI."
msgstr ""
"Galeriak ez du inoiz kontsumitzaile-koderik irakurtzen baimenik gabe. Ezarri "
"<code>DJANGO_COTTON_GALLERY_SCAN_EXTERNAL_USERS = True</code> zure Django "
"settings-etan gaitzeko. Irakurtzeko soilik, garapenerako soilik — txantiloi-"
"bideak soilik agertzen dira galeriaren UIan."

#: templates/django_cotton_gallery/lint.html:8
msgid "Annotation lint"
msgstr "Oharpenen lint"

#: templates/django_cotton_gallery/lint.html:10
msgid ""
"Cross-checks each component's <code>@prop</code> comments against its "
"<code>&lt;c-vars&gt;</code> declaration. Errors mean the prop won't reach "
"the template; warnings flag undocumented or under-documented props."
msgstr ""
"Osagai bakoitzaren <code>@prop</code> iruzkinak <code>&lt;c-vars&gt;</code> "
"deklarazioarekin alderatzen ditu."

#: templates/django_cotton_gallery/lint.html:15
msgid "clean"
msgstr "garbi"

#: templates/django_cotton_gallery/lint.html:39
msgid "Every component is properly annotated."
msgstr "Osagai guztiak ondo oharpenduta daude."

#: templates/django_cotton_gallery/lint.html:66
msgid "Search component or rule…"
msgstr "Bilatu osagaia edo araua…"

#: templates/django_cotton_gallery/lint.html:82
msgid "No components match this filter."
msgstr "Filtro honi dagokion osagairik ez."

#: templates/django_cotton_gallery/lint.html:99
msgid "err"
msgid_plural "err"
msgstr[0] "err"
msgstr[1] "err"

#: templates/django_cotton_gallery/lint.html:143
msgid "Show"
msgstr "Erakutsi"

#: templates/django_cotton_gallery/lint.html:149
msgid "Items per page"
msgstr "Orriko elementuak"

#: templates/django_cotton_gallery/lint.html:172
msgid "per page"
msgstr "orriko"

#: templates/django_cotton_gallery/lint.html:177
msgid "0 components"
msgstr "0 osagai"

#: templates/django_cotton_gallery/lint.html:178
#, python-brace-format
msgid "Showing {start}–{end} of {total}"
msgstr "{start}–{end} / {total} erakusten"

#: templates/django_cotton_gallery/lint.html:187
msgid "Previous page"
msgstr "Aurreko orria"

#: templates/django_cotton_gallery/lint.html:191
msgid "Next page"
msgstr "Hurrengo orria"

#: templates/django_cotton_gallery/setup_guide.html:7
msgid "Setup needed"
msgstr "Konfigurazioa beharrezkoa"

#: templates/django_cotton_gallery/setup_guide.html:407
msgid "Welcome — let's get you set up"
msgstr "Ongi etorri — konfigura dezagun"

#: templates/django_cotton_gallery/setup_guide.html:408
msgid ""
"A few things still need to be configured before the gallery can show your "
"components. Follow the steps below to get started."
msgstr ""
"Galeriak zure osagaiak erakutsi aurretik gauza batzuk konfiguratu behar "
"dira. Jarraitu beheko urratsak hasteko."

#: templates/django_cotton_gallery/setup_guide.html:444
msgid "Once configured, refresh this page and the gallery will load."
msgstr "Konfiguratu ondoren, birkargatu orri hau eta galeria kargatuko da."

#: templatetags/catalog_tags.py:33
#, python-format
msgid ""
"`%(prop)s`: `:` prefix mismatch — @prop is `%(prop_name)s` but <c-vars> has "
"`%(cvar_name)s`."
msgstr ""
"`%(prop)s`: `:` aurrizki bat ez dator — @prop `%(prop_name)s` da baina <c-"
"vars>-ek `%(cvar_name)s` du."

#: templatetags/catalog_tags.py:36
#, python-format
msgid ""
"`%(prop)s`: @prop default is `%(prop_default)s` but <c-vars> has "
"`%(cvar_default)s`."
msgstr ""
"`%(prop)s`: @prop-en lehenetsia `%(prop_default)s` da baina <c-vars>-ek "
"`%(cvar_default)s` du."

#: templatetags/catalog_tags.py:38
#, python-format
msgid "`%(prop)s`: @prop has no `| description:` filter."
msgstr "`%(prop)s`: @prop-ek ez du `| description:` iragazkirik."

#: templatetags/catalog_tags.py:40
msgid ""
"Component declares `@prop` annotations but no `<c-vars>` tag — Cotton will "
"not pass anything to the template."
msgstr ""
"Osagaiak `@prop` oharrak deklaratzen ditu baina ez `<c-vars>` etiketarik — "
"Cotton-ek ez dio txantiloiari ezer pasako."

#: templatetags/catalog_tags.py:43
#, python-format
msgid ""
"`%(prop)s`: @prop is declared but missing from <c-vars> — the prop will "
"never reach the template."
msgstr ""
"`%(prop)s`: @prop deklaratuta dago baina <c-vars>-en falta da — prop-a ez da "
"inoiz txantiloira iritsiko."

#: templatetags/catalog_tags.py:46
#, python-format
msgid "`%(prop)s`: declared in <c-vars> but no `@prop` comment documents it."
msgstr ""
"`%(prop)s`: <c-vars>-en deklaratuta baina ez du `@prop` iruzkinik "
"dokumentatzen."

#: templatetags/catalog_tags.py:49
#, python-format
msgid "No component `%(tag)s` in the catalog — `<c-%(tag)s>` renders nothing."
msgstr ""
"Ez dago `%(tag)s` osagairik katalogoan — `<c-%(tag)s>`-k ez du ezer "
"errendatzen."

#: templatetags/catalog_tags.py:52
#, python-format
msgid ""
"`%(prop)s`: cannot use `| required` together with `| default:` — a required "
"prop has no fallback."
msgstr ""
"`%(prop)s`: ezin da `| required` eta `| default:` batera erabili — prop "
"beharrezkoak ez du fallback-ik."

#: templatetags/catalog_tags.py:55
#, python-format
msgid ""
"`{{ %(ref)s }}` is referenced but not declared in <c-vars>. Heuristic — "
"ignore if it comes from a custom context processor."
msgstr ""
"`{{ %(ref)s }}` erreferentziatzen da baina ez dago <c-vars>-en deklaratuta. "
"Heuristikoa — ezikusi context processor pertsonalizatu batetik badator."

#: templatetags/catalog_tags.py:61
#, python-format
msgid "`%(prop)s`: @prop default `%(value)s` is not in options %(options)s."
msgstr ""
"`%(prop)s`: @prop-en lehenetsia `%(value)s` ez dago aukeretan %(options)s."

#: templatetags/catalog_tags.py:64
#, python-format
msgid "`%(prop)s`: <c-vars> value `%(value)s` is not in options %(options)s."
msgstr ""
"`%(prop)s`: <c-vars>-en `%(value)s` balioa ez dago aukeretan %(options)s."

#: templatetags/catalog_tags.py:72
#, python-format
msgid ""
"`%(prop)s`: type is `boolean` but default `%(raw)s` is not a recognized "
"boolean (use True/False/1/0)."
msgstr ""
"`%(prop)s`: mota `boolean` da baina `%(raw)s` lehenetsia ez da boolean "
"ezaguna (erabili True/False/1/0)."

#: templatetags/catalog_tags.py:75
#, python-format
msgid ""
"`%(prop)s`: type is `number` but default `%(raw)s` is not a valid number."
msgstr ""
"`%(prop)s`: mota `number` da baina `%(raw)s` lehenetsia ez da zenbaki "
"baliozkoa."

#: templatetags/catalog_tags.py:83
#, python-format
msgid ""
"`@prop` head `%(segment)s` is not parseable (expected `name:type`) — the "
"whole annotation is ignored."
msgstr ""
"`@prop` `%(segment)s` burua ezin da analizatu (`name:type` espero zen) — "
"oharpen osoa alde batera uzten da."

#: templatetags/catalog_tags.py:86
#, python-format
msgid ""
"`%(prop)s`: filter segment `%(segment)s` is malformed — it is silently "
"ignored (check quotes and escapes)."
msgstr ""
"`%(prop)s`: `%(segment)s` iragazki-segmentua gaizki eratua dago — isilean "
"alde batera uzten da (egiaztatu komatxoak eta ihesak)."

#: templatetags/catalog_tags.py:91
#, python-format
msgid ""
"`%(prop)s`: unknown filter `%(key)s` — expected one of default, description, "
"required, deprecated, hidden, example."
msgstr ""
"`%(prop)s`: `%(key)s` iragazki ezezaguna — hauetako bat espero zen: default, "
"description, required, deprecated, hidden, example."

