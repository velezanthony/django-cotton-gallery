#: templates/django_cotton_gallery/setup_guide.html:7
msgid "Setup needed"
msgstr "Configuración necesaria"

#: templates/django_cotton_gallery/setup_guide.html:407
msgid "Welcome — let's get you set up"
msgstr "Bienvenido — vamos a configurarlo"

#: templates/django_cotton_gallery/setup_guide.html:408
msgid ""
"A few things still need to be configured before the gallery can show your "
"components. Follow the steps below to get started."
msgstr ""
"Aún quedan unas pocas cosas por configurar antes de que la galería pueda "
"mostrar tus componentes. Sigue los pasos de abajo para empezar."

#: templates/django_cotton_gallery/setup_guide.html:444
msgid "Once configured, refresh this page and the gallery will load."
msgstr "Una vez configurado, recarga esta página y la galería se cargará."

#: templatetags/catalog_tags.py:30
#, python-format
msgid ""
"`%(prop)s`: `:` prefix mismatch — @prop is `%(prop_name)s` but <c-vars> has "
"`%(cvar_name)s`."
msgstr ""
"`%(prop)s`: prefijo `:` no coincide — @prop es `%(prop_name)s` pero <c-vars> "
"tiene `%(cvar_name)s`."

#: templatetags/catalog_tags.py:33
#, python-format
msgid ""
"`%(prop)s`: @prop default is `%(prop_default)s` but <c-vars> has "
"`%(cvar_default)s`."
msgstr ""
"`%(prop)s`: el default de @prop es `%(prop_default)s` pero <c-vars> tiene "
"`%(cvar_default)s`."

#: templatetags/catalog_tags.py:36
#, python-format
msgid "`%(prop)s`: @prop has no `| description:` filter."
msgstr "`%(prop)s`: @prop no tiene filtro `| description:`."

#: templatetags/catalog_tags.py:39
msgid ""
"Component declares `@prop` annotations but no `<c-vars>` tag — Cotton will "
"not pass anything to the template."
msgstr ""
"El componente declara anotaciones `@prop` pero no la etiqueta `<c-vars>` — "
"Cotton no pasará nada a la plantilla."

#: templatetags/catalog_tags.py:42
#, python-format
msgid ""
"`%(prop)s`: @prop is declared but missing from <c-vars> — the prop will "
"never reach the template."
msgstr ""
"`%(prop)s`: @prop está declarado pero falta en <c-vars> — el prop nunca "
"llegará a la plantilla."

#: templatetags/catalog_tags.py:45
#, python-format
msgid "`%(prop)s`: declared in <c-vars> but no `@prop` comment documents it."
msgstr ""
"`%(prop)s`: declarado en <c-vars> pero ningún comentario `@prop` lo "
"documenta."

#: templatetags/catalog_tags.py:48
#, python-format
msgid ""
"`%(prop)s`: cannot use `| required` together with `| default:` — a required "
"prop has no fallback."
msgstr ""
"`%(prop)s`: no se puede usar `| required` con `| default:` — un prop "
"requerido no tiene fallback."

#: templatetags/catalog_tags.py:51
#, python-format
msgid ""
"`{{ %(ref)s }}` is referenced but not declared in <c-vars>. Heuristic — "
"ignore if it comes from a custom context processor."
msgstr ""
"`{{ %(ref)s }}` se referencia pero no está declarado en <c-vars>. Heurística "
"— ignora si viene de un context processor propio."

#: templatetags/catalog_tags.py:55
#, python-format
msgid "`%(prop)s`: @prop default `%(value)s` is not in options %(options)s."
msgstr ""
"`%(prop)s`: el default de @prop `%(value)s` no está en las opciones "
"%(options)s."

#: templatetags/catalog_tags.py:58
#, python-format
msgid "`%(prop)s`: <c-vars> value `%(value)s` is not in options %(options)s."
msgstr ""
"`%(prop)s`: el valor de <c-vars> `%(value)s` no está en las opciones "
"%(options)s."

#: templatetags/catalog_tags.py:63
#, python-format
msgid ""
"`%(prop)s`: type is `boolean` but default `%(raw)s` is not a recognized "
"boolean (use True/False/1/0)."
msgstr ""
"`%(prop)s`: el tipo es `boolean` pero el default `%(raw)s` no es un booleano "
"reconocido (usa True/False/1/0)."

#: templatetags/catalog_tags.py:66
#, python-format
msgid ""
"`%(prop)s`: type is `number` but default `%(raw)s` is not a valid number."
msgstr ""
"`%(prop)s`: el tipo es `number` pero el default `%(raw)s` no es un número "
"válido."
