#: templates/django_cotton_gallery/setup_guide.html:7
msgid "Setup needed"
msgstr "Configuration nécessaire"

#: templates/django_cotton_gallery/setup_guide.html:407
msgid "Welcome — let's get you set up"
msgstr "Bienvenue — configurons cela"

#: templates/django_cotton_gallery/setup_guide.html:408
msgid ""
"A few things still need to be configured before the gallery can show your "
"components. Follow the steps below to get started."
msgstr ""
"Quelques éléments doivent encore être configurés avant que la galerie "
"puisse afficher vos composants. Suivez les étapes ci-dessous pour "
"commencer."

#: templates/django_cotton_gallery/setup_guide.html:444
msgid "Once configured, refresh this page and the gallery will load."
msgstr "Une fois configuré, rechargez cette page et la galerie se chargera."

#: templatetags/catalog_tags.py:33
#, python-format
msgid ""
"`%(prop)s`: `:` prefix mismatch — @prop is `%(prop_name)s` but <c-vars> has"
" `%(cvar_name)s`."
msgstr ""
"`%(prop)s`: préfixe `:` non concordant — @prop est `%(prop_name)s` mais "
"<c-vars> a `%(cvar_name)s`."

#: templatetags/catalog_tags.py:36
#, python-format
msgid ""
"`%(prop)s`: @prop default is `%(prop_default)s` but <c-vars> has "
"`%(cvar_default)s`."
msgstr ""
"`%(prop)s`: la valeur par défaut de @prop est `%(prop_default)s` mais "
"<c-vars> a `%(cvar_default)s`."

#: templatetags/catalog_tags.py:38
#, python-format
msgid "`%(prop)s`: @prop has no `| description:` filter."
msgstr "`%(prop)s`: @prop n'a pas de filtre `| description:`."

#: templatetags/catalog_tags.py:40
msgid ""
"Component declares `@prop` annotations but no `<c-vars>` tag — Cotton will "
"not pass anything to the template."
msgstr ""
"Le composant déclare des annotations `@prop` mais aucune balise `<c-vars>` "
"— Cotton ne transmettra rien au template."

#: templatetags/catalog_tags.py:43
#, python-format
msgid ""
"`%(prop)s`: @prop is declared but missing from <c-vars> — the prop will "
"never reach the template."
msgstr ""
"`%(prop)s`: @prop est déclaré mais absent de <c-vars> — le prop n'atteindra"
" jamais le template."

#: templatetags/catalog_tags.py:46
#, python-format
msgid "`%(prop)s`: declared in <c-vars> but no `@prop` comment documents it."
msgstr ""
"`%(prop)s`: déclaré dans <c-vars> mais aucun commentaire `@prop` ne le "
"documente."

#: templatetags/catalog_tags.py:49
#, python-format
msgid ""
"No component `%(tag)s` in the catalog — `<c-%(tag)s>` renders nothing."
msgstr ""
"Aucun composant `%(tag)s` dans le catalogue — `<c-%(tag)s>` ne rend rien."

#: templatetags/catalog_tags.py:52
#, python-format
msgid ""
"`%(prop)s`: cannot use `| required` together with `| default:` — a required"
" prop has no fallback."
msgstr ""
"`%(prop)s`: impossible d'utiliser `| required` avec `| default:` — un prop "
"requis n'a pas de fallback."

#: templatetags/catalog_tags.py:55
#, python-format
msgid ""
"`{{ %(ref)s }}` is referenced but not declared in <c-vars>. Heuristic — "
"ignore if it comes from a custom context processor."
msgstr ""
"`{{ %(ref)s }}` est référencé mais non déclaré dans <c-vars>. Heuristique —"
" ignorer s'il provient d'un context processor personnalisé."

#: templatetags/catalog_tags.py:61
#, python-format
msgid "`%(prop)s`: @prop default `%(value)s` is not in options %(options)s."
msgstr ""
"`%(prop)s`: la valeur par défaut de @prop `%(value)s` n'est pas dans les "
"options %(options)s."

#: templatetags/catalog_tags.py:64
#, python-format
msgid "`%(prop)s`: <c-vars> value `%(value)s` is not in options %(options)s."
msgstr ""
"`%(prop)s`: la valeur de <c-vars> `%(value)s` n'est pas dans les options "
"%(options)s."

#: templatetags/catalog_tags.py:72
#, python-format
msgid ""
"`%(prop)s`: type is `boolean` but default `%(raw)s` is not a recognized "
"boolean (use True/False/1/0)."
msgstr ""
"`%(prop)s`: le type est `boolean` mais la valeur par défaut `%(raw)s` n'est"
" pas un booléen reconnu (utilisez True/False/1/0)."

#: templatetags/catalog_tags.py:75
#, python-format
msgid ""
"`%(prop)s`: type is `number` but default `%(raw)s` is not a valid number."
msgstr ""
"`%(prop)s`: le type est `number` mais la valeur par défaut `%(raw)s` n'est "
"pas un nombre valide."

#: templatetags/catalog_tags.py:83
#, python-format
msgid ""
"`@prop` head `%(segment)s` is not parseable (expected `name:type`) — the "
"whole annotation is ignored."
msgstr ""
"L'en-tête `@prop` `%(segment)s` n'est pas analysable (attendu `name:type`) "
"— toute l'annotation est ignorée."

#: templatetags/catalog_tags.py:86
#, python-format
msgid ""
"`%(prop)s`: filter segment `%(segment)s` is malformed — it is silently "
"ignored (check quotes and escapes)."
msgstr ""
"`%(prop)s` : le segment de filtre `%(segment)s` est mal formé — il est "
"ignoré silencieusement (vérifiez les guillemets et les échappements)."

#: templatetags/catalog_tags.py:91
#, python-format
msgid ""
"`%(prop)s`: unknown filter `%(key)s` — expected one of default, "
"description, required, deprecated, hidden, example."
msgstr ""
"`%(prop)s` : filtre inconnu `%(key)s` — attendu l'un de default, "
"description, required, deprecated, hidden, example."

#, python-format
#~ msgid ""
